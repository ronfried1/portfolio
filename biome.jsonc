{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      // Component selectors sharing tags can have different specificity without ever matching the same element.
      "style": { "noDescendingSpecificity": "off" }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
